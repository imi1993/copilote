{
  "manifest_version": 3,
  "name": "Copilote de réunion",
  "version": "2.2.1",
  "description": "Transcription en direct, explications en français et compte rendu pour vos réunions Meet, Zoom et Teams (navigateur).",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "sidePanel", "offscreen", "storage", "activeTab", "tabs", "unlimitedStorage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Copilote de réunion : démarrer l'écoute" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Démarrer le copilote sur cet onglet"
    }
  }
}
